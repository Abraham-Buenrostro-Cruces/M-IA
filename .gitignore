# --- Secretos y credenciales (nunca en el repositorio; ver docs/arquitectura/07) ---
.env
.env.*
!.env.example
*-credenciales*.json
*service-account*.json
application_default_credentials.json

# --- Datos crudos descargados (GTFS); se regeneran con data/scripts/ ---
data/raw/

# --- Evidencias subidas en modo local (fotos de reportes: pueden tener datos personales) ---
backend/almacen_local/

# --- Python ---
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/dev-dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# --- Sistema y editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# --- Claude Code: configuración local de cada máquina ---
.claude/settings.local.json
