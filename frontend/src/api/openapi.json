{
 "openapi": "3.1.0",
 "info": {
  "title": "RutaAccesible — api-core",
  "description": "Planificación de viajes accesibles en Metro, Metrobús y Tren Ligero de la CDMX.",
  "version": "0.1.0"
 },
 "paths": {
  "/rutas/plan": {
   "post": {
    "tags": [
     "rutas"
    ],
    "summary": "Plan",
    "description": "Calcula hasta 3 alternativas accesibles para el perfil indicado.\n\nSi no hay ruta segura, ``hay_ruta_segura`` es falso y se explican los obstáculos\n(regla de seguridad 5). El perfil no se registra en logs (regla 6).",
    "operationId": "plan_rutas_plan_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PeticionPlan"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RespuestaPlan"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/estaciones": {
   "get": {
    "tags": [
     "estaciones"
    ],
    "summary": "Estaciones",
    "description": "Estaciones con su accesibilidad **actual** para quien no puede usar escalones (F3-3).",
    "operationId": "estaciones_estaciones_get",
    "parameters": [
     {
      "name": "sistema",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "METRO",
          "METROBUS",
          "TREN_LIGERO"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Sistema"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CatalogoEstaciones"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/estaciones/{clave}/estado": {
   "get": {
    "tags": [
     "estaciones"
    ],
    "summary": "Estado Estacion",
    "description": "Equipos de una estación con su estado vigente.",
    "operationId": "estado_estacion_estaciones__clave__estado_get",
    "parameters": [
     {
      "name": "clave",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Clave"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EstadoEstacionSalida"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/lugares": {
   "get": {
    "tags": [
     "lugares"
    ],
    "summary": "Lugares",
    "description": "Autocompletado de origen y destino: estaciones y lugares (F3-1).",
    "operationId": "lugares_lugares_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 2,
       "maxLength": 80,
       "title": "Q"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/LugarSalida"
         },
         "title": "Response Lugares Lugares Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/perfiles": {
   "get": {
    "tags": [
     "perfiles"
    ],
    "summary": "Perfiles",
    "description": "Perfiles de movilidad predefinidos. Son plantillas, no datos de una persona.",
    "operationId": "perfiles_perfiles_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/PerfilPredefinido"
         },
         "type": "array",
         "title": "Response Perfiles Perfiles Get"
        }
       }
      }
     }
    }
   }
  },
  "/salud": {
   "get": {
    "tags": [
     "operación"
    ],
    "summary": "Salud",
    "description": "Verificación de vida para Cloud Run y para la demo.\n\nReporta el modo para que siempre sea visible si la instancia usa adaptadores\nsimulados (``local``) o reales (``gcp``).",
    "operationId": "salud_salud_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "string"
         },
         "type": "object",
         "title": "Response Salud Salud Get"
        }
       }
      }
     }
    }
   }
  }
 },
