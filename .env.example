# Copia este archivo como .env y ajusta los valores. .env NO se versiona.

# Modo de los adaptadores (D-10): local = simulados, sin nube; gcp = servicios reales.
RA_MODO=local

# PostGIS local (docker compose, servicio "db").
POSTGRES_USER=ra
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=rutaaccesible
POSTGRES_PUERTO=5432

# Cadena de conexión que usa el backend (debe coincidir con lo de arriba).
RA_BD_URL=postgresql+psycopg://ra:cambia-esta-contrasena@localhost:5432/rutaaccesible
